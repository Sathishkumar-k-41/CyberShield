# Copy to .env.local and fill in the endpoints of YOUR backend.
# These are public URLs baked into the frontend bundle — never put API keys here.
# Keep provider keys (LLM, threat-intel vendors) on the server behind these endpoints.

# AI Security Copilot. POST { messages: [{ role, content }] } -> { reply: string }
VITE_COPILOT_API_URL=

# Threat-intel lookups used during scans.
# POST { indicators: string[] } -> { results: [{ indicator, verdict: "malicious"|"suspicious"|"no-match", source?, detail? }] }
VITE_THREAT_INTEL_API_URL=

# Feed for the Threat Intelligence page.
# GET -> { indicators: [{ id, indicator, type, classification, category, source, lastChecked }], updatedAt }
VITE_THREAT_FEED_API_URL=
